{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/build/src/index.js" }
  ],
  "functions": {
    "build/src/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
