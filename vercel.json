{
  "version": 2,
  "builds": [
    {
      "src": "build/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/logo.png",
      "dest": "/public/logo.png"
    },
    {
      "src": "/swagger-custom.css",
      "dest": "/public/swagger-custom.css"
    },
    {
      "src": "/(.*)",
      "dest": "/build/src/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1"
  },
  "functions": {
    "build/src/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
